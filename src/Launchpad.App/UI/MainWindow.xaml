<Window x:Class="Launchpad.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Launchpad.App.UI"
        Title="Launchpad" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="True" Background="#FF0B0D14" AllowsTransparency="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        Width="1280" Height="720">
    <Grid x:Name="Root" Background="#FF0B0D14">
        <!-- frosted snapshot of the desktop, captured just before showing -->
        <Image x:Name="Backdrop" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="Linear"/>
        <!-- tint & vignette: sits over the system blur to give it depth -->
        <Rectangle x:Name="Tint" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" RadiusX="0.85" RadiusY="0.95">
                    <GradientStop Color="#2410131C" Offset="0"/>
                    <GradientStop Color="#5510131C" Offset="0.7"/>
                    <GradientStop Color="#8C0A0C12" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- extra darkening while a group window is open (covers the whole screen, not just the grid band) -->
        <Rectangle x:Name="WindowDim" Fill="#70000000" Opacity="0" IsHitTestVisible="False"/>

        <Grid x:Name="Stage" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- search box -->
            <Border x:Name="SearchHost" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,44,0,0" Width="340" Height="42" CornerRadius="21"
                    Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#B3FFFFFF"
                               Margin="16,1,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <TextBlock x:Name="Placeholder" Text="Search apps and files" FontSize="14.5" Foreground="#80FFFFFF"
                               Margin="44,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Margin="44,0,42,1" VerticalAlignment="Center" BorderThickness="0"
                             Background="Transparent" Foreground="White" CaretBrush="White" FontSize="14.5"
                             SelectionBrush="#996AA8FF" SelectionTextBrush="White" Padding="0"
                             TextChanged="OnSearchTextChanged" AutomationProperties.Name="Search"/>
                    <Button x:Name="ClearButton" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"
                            Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,10,0" Visibility="Collapsed"
                            Style="{StaticResource PillButton}" Click="OnClearClick" ToolTip="Clear (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="12" Background="#26FFFFFF">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- home: smooth vertically scrolling app grid -->
            <Grid x:Name="HomeLayer" Grid.Row="1" Margin="0,10,0,0" ClipToBounds="True" Background="Transparent"
                  SizeChanged="OnHomeSizeChanged"
                  PreviewMouseLeftButtonDown="OnPagerMouseDown" PreviewMouseMove="OnPagerMouseMove"
                  PreviewMouseLeftButtonUp="OnPagerMouseUp" MouseWheel="OnPagerWheel">
                <Grid x:Name="PagerMask" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PagerScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Canvas x:Name="Pager">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="PagerShift"/>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Grid>
                <Border x:Name="ScrollThumb" Width="5" Height="60" CornerRadius="2.5" Background="#B3FFFFFF" Opacity="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"/>
                <!-- group window: a frosted square over the dimmed, blurred grid -->
                <Grid x:Name="GroupHost" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="GroupScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Grid x:Name="GroupBlurHost" IsHitTestVisible="False" Background="#FF0E1016">   <!-- opaque base: hides the sharp grid under the window, so only the blurred copy shows -->
                        <Border x:Name="GroupBlurFill" Margin="-90">
                            <Border.Effect>
                                <BlurEffect Radius="34" KernelType="Gaussian" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <Border x:Name="GroupPanel" CornerRadius="46" BorderBrush="#66FFFFFF" BorderThickness="1.2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#78606060" Offset="0"/>
                                <GradientStop Color="#78303030" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid x:Name="GroupContent" Margin="28,24,28,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="GroupNameBox" Grid.Row="0" FontSize="24" FontWeight="SemiBold" Foreground="White" CaretBrush="White"
                                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" MaxLength="40"
                                 SelectionBrush="#996AA8FF" SelectionTextBrush="White"
                                 KeyDown="OnGroupNameKeyDown" LostKeyboardFocus="OnGroupNameLostFocus" AutomationProperties.Name="Group name"/>
                        <Canvas x:Name="GroupCanvas" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GroupHint" Grid.Row="2" FontSize="12.5" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
                <TextBlock x:Name="EmptyAppsText" Text="Loading apps…" FontSize="15" Foreground="{StaticResource SubtleTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>


            <!-- settings button -->
            <Button x:Name="SettingsButton" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,26"
                    Width="34" Height="34" Click="OnSettingsClick" ToolTip="Settings" Content="&#xE713;"
                    FontFamily="{StaticResource IconFont}" FontSize="15" Style="{StaticResource PillButton}" Panel.ZIndex="5">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" Background="#1AFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- settings overlay -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#66000000" PreviewMouseLeftButtonDown="OnSettingsBackdropClick">
            <Border x:Name="SettingsPanel" Width="460" CornerRadius="20" Background="#F2191C25" BorderBrush="#33FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Shortcut" FontSize="14"/>
                            <TextBlock Text="Press it anywhere to open Launchpad" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                        </StackPanel>
                        <Button x:Name="HotkeyButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PillButton}"
                                Click="OnHotkeyClick" PreviewKeyDown="OnHotkeyKeyDown" LostKeyboardFocus="OnHotkeyLostFocus"
                                Foreground="White" Content="Ctrl+Alt+L" MinWidth="130">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="9" Padding="14,7" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" FontSize="14"/>
                            <TextBlock Text="Run quietly in the background after sign-in" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Click="OnStartupToggle"/>
                    </Grid>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Arrange apps" FontSize="14"/>
                        <TextBlock Text="Or just press and hold an icon, then drag it where you want it." FontSize="12"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,8"/>
                        <StackPanel x:Name="ArrangeChips" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Chip}" Content="A–Z" Tag="name" GroupName="arrange" Click="OnArrangeClick"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Most used" Tag="mostused" GroupName="arrange" Click="OnArrangeClick"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Custom" Tag="custom" GroupName="arrange" Click="OnArrangeClick"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Show system tools and helpers" FontSize="14"/>
                            <TextBlock x:Name="UtilitiesInfo" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="UtilitiesSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Click="OnUtilitiesToggle"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="Windows key opens Launchpad" FontSize="14"/>
                            <TextBlock Text="A lone tap replaces the Start menu. Win+E, Win+D and every other Win shortcut still work." FontSize="12"
                                       Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="WinKeySwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Click="OnWinKeyToggle"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Search files" FontSize="14"/>
                            <TextBlock x:Name="IndexSettingsInfo" Text="" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"/>
                        </StackPanel>
                        <CheckBox x:Name="IndexSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Click="OnIndexToggle"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Rebuild file index" Style="{StaticResource PillButton}" Foreground="White" Click="OnRebuildClick" Margin="0,0,8,0"/>
                        <Button Content="Refresh apps" Style="{StaticResource PillButton}" Foreground="White" Click="OnRefreshAppsClick" Margin="0,0,8,0"/>
                        <Button x:Name="UnhideButton" Content="Unhide apps" Style="{StaticResource PillButton}" Foreground="White" Click="OnUnhideClick"/>
                    </StackPanel>

                    <TextBlock Text="Esc closes · type to search · try  ext:pdf  size:&gt;10mb  date:week  type:image  -draft"
                               FontSize="11.5" Foreground="#80FFFFFF" TextWrapping="Wrap" Margin="0,22,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
